# Neptune environment configuration. Copy to `.env` and adjust.

# --- Databases (three-DB topology; see docs/data_architecture.md) ---
# Legacy single-DB knob. If the two Neptune URLs below are unset, both fall back to
# this, so a single-DB dev setup still works. Tests override to sqlite:///:memory:.
DATABASE_URL=postgresql+psycopg://neptune:neptune@localhost:5432/neptune

# Neptune's own databases (read/write). Point these at distinct Postgres databases for
# the production three-DB split; on one cluster that's just two CREATE DATABASE names.
PORTFOLIO_DATABASE_URL=postgresql+psycopg://neptune:neptune@localhost:5432/neptune_portfolios
SECURITIES_DATABASE_URL=postgresql+psycopg://neptune:neptune@localhost:5432/neptune_securities

# Shared securities universe (cato_securities) — READ-ONLY. Use a SELECT-only role.
# Leave unset to fall back to the synthetic universe (offline dev / tests).
UNIVERSE_DATABASE_URL=postgresql+psycopg://readonly:***@localhost:5434/cato_securities

# Quant constants (defaults baked into config.py; override only if you must)
NEPTUNE_EWMA_LAMBDA=0.94
NEPTUNE_BETA_TOL=0.05

# Market-beta benchmark + always-on price refresh interval (minutes; 0 = off).
NEPTUNE_BENCHMARK=SPY
NEPTUNE_PRICE_REFRESH_MINUTES=10

# Seed the demo positions (AAA/BBB/CCC/DDD). Set false for a REAL book: stops seeding AND
# removes existing demo names on startup, so real prices/P&L work (a real benchmark can't
# price synthetic demo names — the whole book otherwise falls back to synthetic).
NEPTUNE_SEED_DEMO_POSITIONS=false

# Redis (Celery — deferred wiring)
REDIS_URL=redis://localhost:6379/0
