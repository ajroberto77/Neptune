# Neptune environment configuration. Copy to `.env` and adjust.

# Canonical dev target = Postgres in docker-compose. Tests override to sqlite:///:memory:
DATABASE_URL=postgresql+psycopg://neptune:neptune@localhost:5432/neptune

# Quant constants (defaults baked into config.py; override only if you must)
NEPTUNE_EWMA_LAMBDA=0.94
NEPTUNE_BETA_TOL=0.05

# Redis (Celery — deferred wiring)
REDIS_URL=redis://localhost:6379/0
